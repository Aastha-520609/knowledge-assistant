# virtual environment — contains all installed packages, not needed on GitHub
venv/

# vector database — large binary files, recreated by running ingest.py
data/

# environment variables — contains API keys, never push this
.env

# python cache files — auto-generated, not needed
__pycache__/
*.pyc
*.pyo
*.pyd

# huggingface model cache — large files, downloaded automatically
.cache/

# runtime logs — generated at query time, not needed on GitHub
logs/

# mac system file — auto-generated by macOS, useless on GitHub
.DS_Store

# vs code settings — editor specific, not needed
.vscode/
*.code-workspace
